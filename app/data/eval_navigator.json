{
  "_meta": {
    "warning": "SYNTHETIC EVALUATION DATA — invented messages, not real people.",
    "description": "End-to-end cases for the full Navigator pipeline: retrieval, generation, grounding validation, and escalation. Written to be messy on purpose — typos, vagueness, several needs at once, plain and non-English phrasing, prompt injection, off-topic asks, questions the data cannot answer, and queries whose best-looking match is a withheld record. No real user text and no patient data.",
    "contains_patient_data": false,
    "fields": {
      "kind": "which failure mode this case probes",
      "expect_answerable": "whether verified resources should be found",
      "expected_categories": "categories a good top result belongs to",
      "expect_escalation": "expected needs_escalation value",
      "must_not_appear": "substrings that must be absent from the final answer",
      "must_appear": "substrings the final answer must contain"
    }
  },
