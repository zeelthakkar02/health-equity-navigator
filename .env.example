# ---------------------------------------------------------------------------
# Health Equity Navigator — example environment file.
# Copy to .env for local development:  cp .env.example .env
#
# This file contains NO secrets and must stay that way. Vertex AI access uses
# Application Default Credentials (ADC), so there is no API key to set here.
#   gcloud auth application-default login
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# text for a terminal, json for a log pipeline (one object per line).
LOG_FORMAT=text
# Never turn this on in production: a message can describe someone's health,
# housing, or immigration situation.
LOG_QUERY_TEXT=false
API_V1_PREFIX=/api/v1

# Comma-separated list of origins allowed to call the API.
# Add the consuming website's origin here at integration time.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# --- LLM provider ---
# stub   = fully offline deterministic provider (default; no cloud calls)
# vertex = Google Gemini via Vertex AI, authenticated with ADC
LLM_PROVIDER=stub
LLM_TEMPERATURE=0.2
# Gemini 3.x spends part of this budget on reasoning before writing.
LLM_MAX_OUTPUT_TOKENS=3072
LLM_TIMEOUT_SECONDS=30

# --- Embeddings (retrieval side; independent of LLM_PROVIDER) ---
# hashing = offline deterministic lexical vectors (default; no cloud calls).
#           Matches on shared wording, not meaning — development and tests only.
# vertex  = Google embedding model via Vertex AI, authenticated with ADC.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# gemini-embedding-001 accepts one input per request on Vertex AI.
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_CONCURRENCY=4

# --- Retrieval ---
# Defaults to the bundled synthetic sample data.
# RESOURCE_DATA_PATH=app/data/sample_resources.json
RETRIEVAL_TOP_K=5
# Minimum semantic similarity, applied before any boost. Leave unset to use the
# value tuned for the configured provider (hashing 0.10, vertex 0.57) — scores
# are an order of magnitude apart, so one number cannot serve both. Re-tune with
# scripts/eval_retrieval.py after changing the data, model, or ranking.
# RETRIEVAL_MIN_SCORE=
RETRIEVAL_LOCATION_BOOST=0.25
# Weight for a service category the person explicitly named in their query.
RETRIEVAL_CATEGORY_BOOST=0.12
RETRIEVAL_CANDIDATE_MULTIPLIER=4
# Resources verified longer ago than this are withheld from results.
RETRIEVAL_MAX_RESOURCE_AGE_DAYS=548
RETRIEVAL_REQUIRE_VERIFIED=true
# Turning this off makes the Navigator answer without citing resources.
RETRIEVAL_ENABLED=true

# --- Request hardening (public API surface) ---
MAX_REQUEST_BYTES=16384
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable behind a proxy that actually sets X-Forwarded-For, or callers can
# spoof their way around the rate limit.
TRUST_PROXY_HEADERS=false

# --- Index persistence ---
# Cached resource embeddings, so a cold start does not re-embed everything.
# Derived data: always rebuildable, and discarded whenever the provider, model,
# dimensions, or resource file changes.
RESOURCE_INDEX_CACHE_ENABLED=true
RESOURCE_INDEX_CACHE_PATH=.cache/resource_index.npz

# --- Google Cloud / Vertex AI (required when LLM_PROVIDER or EMBEDDING_PROVIDER is vertex) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Leave empty for the model's own default. Benchmarking found 'low' ~83% faster
# with no measurable quality loss; measure with scripts/benchmark_navigator.py
# before changing it for your own data.
GEMINI_THINKING_LEVEL=low
